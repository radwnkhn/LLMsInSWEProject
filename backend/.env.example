# Copy to backend/.env and fill in. Never commit the real file.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# claude | gemini | openai
LLM_PROVIDER=claude
LLM_API_KEY=
# Optional: override the provider's default model
LLM_MODEL=
# Comma-separated origins allowed to call the API (the Vercel URL in production)
CORS_ORIGINS=http://localhost:3000
# MediaPipe pose model; download it with scripts/download_pose_model.sh
POSE_MODEL_PATH=models/pose_landmarker_full.task
